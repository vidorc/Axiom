# ─── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ─── Virtual environments / uv ──────────────────────────────────────────────
.venv/
venv/
env/
# uv.lock IS committed — it pins the dependency graph for reproducible builds.

# ─── Test / coverage / type caches ──────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ─── Secrets & local config (SECURITY.md — never commit credentials) ─────────
.env
.env.*
!.env.example
*.pem
*.key
# The local dev master key generated at first run (SECURITY.md §5.5) — never commit.
.secrets/
secrets/
master.key

# ─── Editors / OS ────────────────────────────────────────────────────────────
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Local data / object-store volumes (docker compose) ──────────────────────
.data/
pgdata/
miniodata/

# ─── Frontend (Phase 3 placeholder — keep node_modules out preemptively) ─────
node_modules/
web/.next/
web/out/
