# Axiom configuration — copy to `.env` and adjust. Loaded by pydantic-settings
# (prefix AXIOM_). NEVER commit a real .env (it is gitignored).

# ── Environment ────────────────────────────────────────────────────────────
# dev | test | staging | production
AXIOM_ENVIRONMENT=dev

# ── Datastore (source of truth — ADR-0001) ──────────────────────────────────
AXIOM_DATABASE_URL=postgresql+asyncpg://axiom:axiom@localhost:5432/axiom

# ── Cache / transport (NOT source of truth — ADR-0001) ──────────────────────
AXIOM_REDIS_URL=redis://localhost:6379/0

# ── Secrets / vault (SECURITY.md §5) ─────────────────────────────────────────
# Backend: file | aws_kms | gcp_kms | vault
AXIOM_SECRET_BACKEND=file
AXIOM_MASTER_KEY_PATH=.secrets/master.key
#
# SECURITY.md §5.5: this placeholder is TOLERATED IN DEV ONLY. The app REFUSES TO
# START with this value when AXIOM_ENVIRONMENT is staging/production — generate a
# real key, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AXIOM_MASTER_KEY=CHANGE_ME_GENERATE_A_REAL_KEY

# ── API ──────────────────────────────────────────────────────────────────────
AXIOM_API_HOST=0.0.0.0
AXIOM_API_PORT=8000

# ── Logging (redaction is always applied — SECURITY.md §5.4) ─────────────────
AXIOM_LOG_LEVEL=INFO
# JSON logs in non-dev; set false for pretty console logs locally.
AXIOM_LOG_JSON=true
