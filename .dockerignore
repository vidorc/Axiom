# Keep the Docker build context small and secret-free.
.git
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
coverage.xml

# Never ship secrets or local state into an image (SECURITY.md).
.env
.env.*
!.env.example
.secrets
secrets
*.pem
*.key
master.key

# Throwaway and not-yet-built areas.
spikes
web
.data
pgdata
miniodata

# Docs don't belong in the runtime image.
*.md
docs
DESIGN.md
!README.md
